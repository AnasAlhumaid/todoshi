        }
      }
    },
    "account.delete.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف حساب Todoshi وبيانات التعاون السحابية المرتبطة به نهائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes your Todoshi account and associated cloud collaboration data."
          }
        }
      }
    },
    "account.delete.ownedMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند حذف حسابك سيتم حذف الـ %lld مشاريع المشتركة التي تملكها ومحتواها نهائيًا لجميع الأعضاء، لأنه لا يوجد نقل ملكية حاليًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting your account permanently deletes the %lld shared projects you own and their content for all members, because ownership transfer is not available yet."
          }
        }
      }
    },
    "account.delete.ownedTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
