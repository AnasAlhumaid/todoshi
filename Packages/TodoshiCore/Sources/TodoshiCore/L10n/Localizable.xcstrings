      }
    },
    "privacy.deletion": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يؤدي حذف التطبيق إلى إزالة بياناته المحلية وفق نُسخ iCloud الاحتياطية للجهاز. لا يوفّر Nexus تصديرًا سحابيًا أو استعادة بين الأجهزة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing Nexus may remove its local data, subject to device backups you have configured. Nexus does not currently provide encrypted cloud export or multi-device recovery."
          }
        }
      }
    },
