    "account.delete.requiresRecentLogin": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأسباب أمنية، يتطلب Firebase تسجيل دخول حديثًا. سجّل الخروج ثم سجّل الدخول مرة أخرى وحاول حذف الحساب."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For security, Firebase requires a recent sign-in. Sign out, sign in again, then try deleting your account."
          }
        }
      }
    },
