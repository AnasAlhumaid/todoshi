    "privacy.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Nexus تطبيق مهام محلي. تُحفظ بياناتك في قاعدة على هذا الجهاز، وفي مجموعة التطبيقات ليقرأها الويدجت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nexus is a local-first task app. Your work is stored in a database on this device (and in an App Group container so widgets can read the same data)."
          }
        }
      }
    },
