    "privacy.external": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند فتح رابط مرفق بمهمة، يفتحه iOS خارج Nexus (مثل Safari). لا يرسل Nexus محتوى عن بُعد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you open a link attached to a task, iOS opens it outside Nexus (for example Safari). Nexus does not proxy remote content."
          }
        }
      }
    },
