    "account.delete.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف حسابك وبياناتك المرتبطة به من Todoshi.\nلا يمكن التراجع عن هذا الإجراء."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Todoshi account and associated data will be deleted.\nThis action cannot be undone."
          }
        }
      }
    },
    "account.delete.confirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف حسابك نهائيًا؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your account permanently?"
          }
        }
      }
    },
    "account.delete.continue": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متابعة حذف الحساب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue Deletion"
          }
        }
      }
    },
    "account.delete.error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إكمال حذف الحساب. حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account deletion couldn't be completed. Please try again."
          }
        }
      }
    },
    "account.delete.failedTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حذف الحساب"
